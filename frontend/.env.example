# React environment variables.
# Copy this file to `.env` and adjust for your environment before `npm start`.

# Backend API base URL. For local dev, the Django dev server listens on 8000.
REACT_APP_API_URL=http://localhost:8000/api

# One-click demo logins on /login (accounts from `python manage.py demo_setup`,
# password "demo"). Off unless exactly "true". Local evaluation only — never
# set this for a production build.
# REACT_APP_SHOW_DEMO=true
