# ============================================================================
#  Social Stats — docker-compose configuration
#
#      cp .env.docker.example .env.docker      # then fill in the REQUIRED block
#      docker compose --env-file .env.docker up -d
#
#  --env-file feeds the ${VAR} checks in docker-compose.yml (compose stops
#  with a clear message if a required value is missing); `env_file:` in the
#  compose file then passes everything here to the backend/worker/beat
#  containers. The backend itself refuses to boot with DEBUG=False if
#  SECRET_KEY, FIELD_ENCRYPTION_KEYS, ALLOWED_HOSTS or the webhook secrets
#  are unsafe — see docs/GOING_LIVE.md and docs/CONFIGURATION.md.
#
#  Never commit .env.docker.
# ============================================================================

# ── REQUIRED ────────────────────────────────────────────────────────────────
# 50+ random characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Fernet key(s) for OAuth tokens at rest, comma-separated, newest first:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEYS=

# Webhook signing secrets. Required unless ALLOW_UNSIGNED_WEBHOOKS=True.
#   META_WEBHOOK_SECRET    = your Meta app's App Secret (signs X-Hub-Signature-256)
#   WHATSAPP_WEBHOOK_SECRET = random 32+ chars, also entered in Pinbot
META_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_SECRET=
# Not using Meta/WhatsApp webhooks (e.g. a local trial)? Set this instead.
# The app then boots without the secrets, and those webhook endpoints reject
# every delivery.
# ALLOW_UNSIGNED_WEBHOOKS=True

# ── Host & TLS ──────────────────────────────────────────────────────────────
# Keep localhost in the list — the container healthcheck calls
# http://localhost:8000. Add your real domain(s) for production.
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000
# Behind your own TLS-terminating proxy, set all three to True.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=socialstats

# ── Optional ────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# FRONTEND_PORT=3000
# MEDIA_MAX_UPLOAD_MB=100
# META_API_VERSION=v24.0
# Platform OAuth apps, email, WhatsApp/Pinbot: see backend/.env.example.
